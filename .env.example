# Copy to .env and adjust as needed. NexusDB reads these via os.getenv(),
# so a plain `export` or a `.env` loaded by your process manager both work.

# Enable auto-save-on-write / auto-load-on-startup for collections.
# Off by default — everything is in-memory only unless this is "true".
NEXUSDB_AUTO_PERSIST=false

# Directory where per-collection SQLite files are written when
# NEXUSDB_AUTO_PERSIST=true.
NEXUSDB_PERSIST_DIR=./data

# --- API (nexusdb/api/config.py) ---

# Require every /v1 request to send a matching `X-API-Key` header.
# Unset (default) disables auth entirely — fine for local dev, not for a
# real deployment. /health is never gated by this.
# NEXUSDB_API_KEY=

# Comma-separated list of allowed CORS origins. Defaults to the Vite dev
# server only; set explicitly for any other deployment (never "*").
NEXUSDB_CORS_ORIGINS=http://localhost:5173

# Per-client-IP rate limit in slowapi's "<count>/<period>" syntax, applied
# to every /v1 route.
NEXUSDB_RATE_LIMIT=120/minute

# --- Observability (nexusdb/observability/) ---

# Log level for nexusdb.* loggers.
NEXUSDB_LOG_LEVEL=INFO

# "json" (default, machine-parseable — every line includes a request_id
# correlating it to one HTTP request) or "text" (easier to read locally).
NEXUSDB_LOG_FORMAT=json

# Off by default (a span per request would spam every local run and CI log).
# Set to "true" to emit OpenTelemetry spans across the search path to the
# console. See nexusdb/observability/tracing.py to swap in a real exporter
# (OTLP → Jaeger/Tempo/etc.) instead of the console.
NEXUSDB_TRACING_ENABLED=false

# Prometheus metrics are always on at GET /metrics — no flag needed.

# --- UI (ui/.env, picked up by Vite at build time) ---
# Not required for local dev — the Vite dev server proxies /api to
# http://localhost:8000 (see ui/vite.config.js). Only needed if you're
# pointing a built frontend at a non-default API origin.
# VITE_API_BASE=http://localhost:8000
